# Copier vers .env et renseigner les valeurs.

# D-ID (Studio → Account settings), recommandé : API_USERNAME:API_PASSWORD (affiché une seule fois).
# Sinon une seule clé secrète : le serveur enverra base64(clé + ":") comme attendu par l’API.
# Ne pas mettre un hash ou un blob arbitraire : si ce n’est pas user:pass ni la clé brute, l’auth échoue.
DID_API_KEY=

# Optionnel — image du visage pour le stream WebRTC (sinon Noelle_f, plus sobre qu’Emma_f).
# DID_STREAM_SOURCE_URL=https://…
# DID_DEFAULT_STREAM_SOURCE_URL=https://create-images-results.d-id.com/DefaultPresenters/Noelle_f/v1_image.jpeg

# Groq (transcription Whisper)
GROQ_API_KEY=
