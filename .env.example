# Copier vers .env et renseigner les valeurs.

# Avatar temps réel (Simli) — https://simli.com — clé API : header x-simli-api-key
SIMLI_API_KEY=
# ID visage (ex. visage preset ou créé sur app.simli.com)
SIMLI_FACE_ID=tmp9i8bbq7c

# TTS Edge pour convertir la réponse en PCM 16 kHz (avatar) — ffmpeg obligatoire
SIMLI_TTS_VOICE=fr-FR-DeniseNeural
# Sous Windows si ffmpeg n'est pas dans le PATH : chemin complet vers ffmpeg.exe
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# D-ID (optionnel, ex. ask-full-avatar vidéo) : API_USERNAME:API_PASSWORD
DID_API_KEY=

# Groq (transcription Whisper)
GROQ_API_KEY=
